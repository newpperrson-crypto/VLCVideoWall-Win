# ============================================================
#  Настройка видеостены
#
#  Скопируйте этот файл в Mosaic.conf рядом с VLCVideoWall.exe и правьте его.
#  Приложение перезаписывает файл по кнопке «Сохранить», поэтому правки руками
#  и через окно не расходятся — источник правды один.
#
#  layout  = КОЛОНКИxСТРОКИ    1x1 ... 4x4, всего не больше 16 окон
#  canvas  = ШИРИНАxВЫСОТА     1280x720, 1920x1080, 2560x1440, 3840x2160,
#                              1280x1024 или своё от 640x480 до 3840x2160
#  cam ИМЯ rtsp://АДРЕС        по строке на камеру; ИМЯ — уникальное латинское;
#                              порядок строк = порядок окон: слева-направо,
#                              сверху-вниз
#  port_wall = 4212 / port_guard = 42130 / port_audio = 4213
#                              локальные порты, должны быть разными
#  windowed = yes|no           yes = стена в окне размером с полотно,
#                              no = на весь экран (по умолчанию)
#  vlcpath = путь к vlc.exe    пусто = найти автоматически
#  logdir  = папка журнала     пусто = папка программы
#  logkeep = сколько дней      0 = не удалять
# ============================================================

layout = 2x2
canvas = 1920x1080
windowed = no
port_wall = 4212
port_guard = 42130
port_audio = 4213

# Замените на свои камеры. `user:password` — условные значения: настоящие логин
# и пароль живут только в этом файле и никогда в репозитории.
# Символы @ : / ? # % + внутри логина и пароля кодируйте
# (например, `p@ss` -> `p%40ss`) — см. docs/configuration.md.
cam ch1 rtsp://user:password@192.0.2.11:554/Streaming/Channels/101
cam ch2 rtsp://user:password@192.0.2.12:554/live/ch00_1
# cam ch3 rtsp://user:password@192.0.2.13:554/ISAPI/Streaming/Channels/1601

logkeep = 30
