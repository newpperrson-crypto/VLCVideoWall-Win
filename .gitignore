[Bb]in/
[Oo]bj/
[Pp]ublish/
dist/
*.user
*.suo
.vs/

# --- рабочие данные: настоящий конфиг и его следы не коммитим -----------
# В Mosaic.conf, его копиях и Mosaic.vlm хранятся логин и пароль камер.
Mosaic.conf
Mosaic.conf.*
# шаблон для пользователей — не секрет, публикуется
!config/Mosaic.conf.example
Mosaic*.bak
Mosaic.vlm
Mosaic.active.vlm
*.bak

# настройки окна: старые и текущие имена
VLCVideoWall.settings.json
VideoWall.settings.json

# служебные файлы запущенной стены
vlc.pid
watchdog.heartbeat
watchdog.status
audio.status
audio.pid
audio.cmd
stop.flag
*.log
bg_*.jpg

# --- мусор операционной системы и редакторов ---------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
